# Same Neon Auth URL as the client dashboard (shared accounts).
VITE_NEON_AUTH_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth
# Ainvoker API origin. Admin access is granted via PLATFORM_ADMIN_USER_IDS on the API.
VITE_API_URL=http://localhost:3000
# Client dashboard, shown to signed-in users who are not platform admins.
VITE_CLIENT_URL=http://localhost:5173
